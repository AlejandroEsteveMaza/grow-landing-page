---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface-strong">
  <div
    class="mx-auto flex w-full max-w-site flex-col gap-6 px-6 py-10 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left md:px-10 lg:px-16"
  >
    <a
      class="inline-flex min-h-11 items-center justify-center font-display text-2xl font-black tracking-[-0.06em] text-foreground transition-colors hover:text-primary focus-visible:text-primary sm:justify-start"
      href="/"
      aria-label="TuNorte, volver al inicio"
    >
      TuNorte<span class="text-primary">.</span>
    </a>
    <p class="text-sm text-muted">© {currentYear} TuNorte · Diseño web que te representa</p>
  </div>
</footer>
