---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface-strong">
  <div class="mx-auto w-full max-w-site px-6 md:px-10 lg:px-16">
    <div class="grid gap-8 border-b border-border py-12 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end sm:py-14">
      <a
        class="inline-flex min-h-11 w-fit items-center font-display text-4xl font-black tracking-[-0.065em] text-foreground transition-colors hover:text-primary focus-visible:text-primary sm:text-5xl"
        href="/"
        aria-label="TuNorte, volver al inicio"
      >
        TuNorte<span class="text-primary">.</span>
      </a>

      <p class="flex max-w-xs items-center gap-4 text-base leading-7 text-muted sm:justify-end sm:text-right">
        <span class="h-px w-10 shrink-0 bg-primary" aria-hidden="true"></span>
        Diseño web que te representa
      </p>
    </div>

    <div class="flex flex-col gap-3 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {currentYear} TuNorte</p>
      <a
        class="inline-flex min-h-11 w-fit items-center underline decoration-border underline-offset-4 transition-colors hover:text-foreground focus-visible:text-foreground"
        href="/privacidad/"
      >
        Política de Privacidad
      </a>
    </div>
  </div>
</footer>
