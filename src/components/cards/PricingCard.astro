---
import type { PricingPlan } from '../../types/content';

interface Props {
  plan: PricingPlan;
}

const { plan } = Astro.props;
---

<article
  class:list={[
    'reveal relative flex flex-col rounded-card border p-7 transition-[border-color,transform] duration-300 hover:-translate-y-1.5 hover:border-primary sm:p-10 lg:p-12',
    plan.featured
      ? 'border-primary bg-[linear-gradient(135deg,rgba(200,90,58,0.08),transparent_60%)]'
      : 'border-border bg-background',
  ]}
>
  {plan.featured && <p class="absolute right-5 top-5 rounded-full bg-primary px-3.5 py-1.5 text-[0.6rem] font-bold uppercase tracking-[0.14em] text-white">Más elegido</p>}
  <p class="text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-muted">{plan.number}</p>
  <h3 class="mt-3 pr-20 font-display text-3xl font-bold tracking-tight text-foreground">{plan.name}</h3>
  <p class="mt-4 min-h-20 text-sm leading-6 text-muted">{plan.description}</p>
  <p class="mt-8 font-display text-6xl font-black tracking-[-0.06em] text-foreground">{plan.price}</p>
  <p class="mt-2 text-xs text-muted">{plan.note}</p>
  <div class="my-7 h-px bg-border"></div>
  <ul class="flex-1" aria-label={`Incluido en ${plan.name}`}>
    {
      plan.features.map((feature) => (
        <li class="flex gap-3 border-b border-border py-2.5 text-sm leading-6 text-subtle last:border-b-0">
          <span class="font-bold text-primary" aria-hidden="true">✓</span>
          <span>{feature}</span>
        </li>
      ))
    }
  </ul>
  <a
    class:list={[
      'mt-8 inline-flex min-h-12 items-center justify-center rounded-brand px-5 py-3 text-center text-sm font-bold transition-[background-color,border-color,color,transform] hover:-translate-y-0.5 focus-visible:-translate-y-0.5',
      plan.featured
        ? 'bg-primary text-white hover:bg-primary-hover focus-visible:bg-primary-hover'
        : 'border border-border text-foreground hover:border-primary hover:text-primary focus-visible:border-primary focus-visible:text-primary',
    ]}
    href="#contacto"
  >
    {plan.cta}
  </a>
</article>
