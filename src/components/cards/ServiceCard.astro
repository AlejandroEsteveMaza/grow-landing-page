---
import type { Service } from '../../types/content';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article
  class="reveal reveal-interactive group relative overflow-hidden bg-surface p-7 transition-colors duration-500 hover:bg-surface-hover focus-within:bg-surface-hover sm:p-10 lg:p-14"
>
  <span
    class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-gradient-to-r from-primary to-transparent transition-transform duration-500 group-hover:scale-x-100 group-focus-within:scale-x-100"
    aria-hidden="true"
  ></span>
  <p class="font-display text-6xl font-black leading-none text-border transition-colors group-hover:text-primary">
    {service.number}
  </p>
  <p class="mt-7 text-[0.65rem] font-semibold uppercase tracking-[0.24em] text-accent-text">{service.tier}</p>
  <h3 class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight text-foreground">{service.title}</h3>
  <p class="mt-5 max-w-lg text-[0.95rem] leading-7 text-muted">{service.description}</p>
  <ul class="mt-8" aria-label={`Incluido en ${service.title}`}>
    {
      service.features.map((feature) => (
        <li class="flex gap-3 border-b border-border py-2.5 text-sm leading-6 text-subtle last:border-b-0">
          <span class="text-primary" aria-hidden="true">→</span>
          <span>{feature}</span>
        </li>
      ))
    }
  </ul>
  <a
    class="group/link mt-8 inline-flex min-h-11 items-center gap-2 text-sm font-bold text-foreground transition-colors hover:text-accent-text focus-visible:text-accent-text"
    href="#servicios"
  >
    Ver detalles y precio <span class="inline-block transition-transform duration-300 ease-out group-hover/link:translate-x-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none" aria-hidden="true">→</span>
  </a>
</article>
