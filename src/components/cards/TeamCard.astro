---
import { Image } from 'astro:assets';
import type { TeamMember } from '../../types/content';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
---

<article
  class="reveal group relative overflow-hidden bg-surface p-7 transition-colors duration-500 hover:bg-surface-hover sm:p-10 lg:p-14"
>
  <span
    class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-gradient-to-r from-primary to-transparent transition-transform duration-500 group-hover:scale-x-100"
    aria-hidden="true"
  ></span>
  <div class="size-24 overflow-hidden rounded-full border-2 border-border transition-[border-color,transform] group-hover:scale-105 group-hover:border-primary">
    <Image
      class="h-full w-full object-cover object-top"
      src={member.image}
      alt={member.imageAlt}
      width={192}
      height={192}
      loading="lazy"
      quality={85}
    />
  </div>
  <p class="mt-8 text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-primary">{member.role}</p>
  <h3 class="mt-3 font-display text-3xl font-black tracking-tight text-foreground">{member.name}</h3>
  <p class="mt-5 text-[0.95rem] leading-7 text-muted">{member.bio}</p>
  <ul class="mt-7 flex flex-wrap gap-2" aria-label={`Especialidades de ${member.name}`}>
    {
      member.tags.map((tag) => (
        <li class="rounded-full bg-border px-3.5 py-1.5 text-xs font-medium text-subtle transition-colors group-hover:bg-primary/10 group-hover:text-primary">
          {tag}
        </li>
      ))
    }
  </ul>
</article>
