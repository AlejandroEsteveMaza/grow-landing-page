---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  meta?: string;
  symbol?: string;
  href?: string | undefined;
}

const { eyebrow, title, description, meta, symbol, href } = Astro.props;
---

<article class="reveal group flex h-full flex-col rounded-card border border-border bg-surface p-7 transition-[border-color,transform] duration-300 hover:-translate-y-1.5 hover:border-primary sm:p-9">
  {
    symbol && (
      <span class="mb-6 grid size-12 place-items-center rounded-brand border border-primary/25 bg-primary/10 font-display text-xl font-bold text-primary" aria-hidden="true">
        {symbol}
      </span>
    )
  }
  <p class="text-[0.65rem] font-bold uppercase tracking-[0.22em] text-primary">{eyebrow}</p>
  <h3 class="mt-3 font-display text-xl font-bold leading-snug tracking-tight text-foreground">
    {href ? <a class="transition-colors hover:text-primary focus-visible:text-primary" href={href}>{title}</a> : title}
  </h3>
  <p class="mt-4 flex-1 text-sm leading-6 text-muted">{description}</p>
  <div class="mt-6 border-t border-border pt-4 text-xs text-muted">
    {meta ?? 'Disponible próximamente'}
  </div>
</article>
