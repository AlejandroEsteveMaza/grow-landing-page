---
import PricingCard from '../cards/PricingCard.astro';
import type { MaintenancePlan, PricingPlan } from '../../types/content';

interface Props {
  plans: readonly PricingPlan[];
  maintenance: MaintenancePlan;
}

const { plans, maintenance } = Astro.props;
---

<section class="scroll-mt-20 border-b border-border bg-surface-strong" id="precios" aria-labelledby="pricing-title">
  <div class="mx-auto w-full max-w-site px-6 py-20 md:px-10 md:py-28 lg:px-16 lg:py-32">
    <p class="reveal flex items-center gap-3 text-[0.68rem] font-semibold uppercase tracking-[0.25em] text-primary">
      <span class="h-px w-6 bg-primary" aria-hidden="true"></span>Inversión
    </p>
    <h2 class="reveal mt-4 font-display text-[clamp(2.5rem,5vw,4.25rem)] font-black leading-[0.96] tracking-[-0.045em] text-foreground" id="pricing-title">
      Elige el plan<br /><span class="text-muted">que necesita tu negocio</span>
    </h2>
    <div class="mt-14 grid gap-6 md:mt-16 lg:grid-cols-2">
      {plans.map((plan) => <PricingCard plan={plan} />)}
    </div>

    <article class="reveal mt-6 overflow-hidden rounded-card border border-border transition-colors hover:border-primary">
      <header class="flex flex-col gap-5 border-b border-border bg-surface p-7 sm:flex-row sm:items-end sm:justify-between sm:p-10 lg:px-12">
        <div>
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-primary">Servicio adicional</p>
          <h3 class="mt-2 font-display text-2xl font-bold tracking-tight text-foreground">
            {maintenance.name} <span class="text-primary">— {maintenance.tagline}</span>
          </h3>
        </div>
        <p class="font-display text-4xl font-black tracking-tight text-foreground">{maintenance.price}</p>
      </header>
      <div class="grid lg:grid-cols-2">
        <div class="p-7 sm:p-10 lg:border-r lg:border-border lg:px-12">
          <h4 class="text-xs font-bold uppercase tracking-[0.18em] text-primary">✓ Lo que sí incluye</h4>
          <ul class="mt-5">
            {
              maintenance.included.map((item) => (
                <li class="flex gap-3 border-b border-border py-2.5 text-sm leading-6 text-subtle last:border-b-0">
                  <span class="font-bold text-primary" aria-hidden="true">✓</span><span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="border-t border-border p-7 sm:p-10 lg:border-t-0 lg:px-12">
          <h4 class="text-xs font-bold uppercase tracking-[0.18em] text-danger">× Lo que no incluye</h4>
          <ul class="mt-5">
            {
              maintenance.excluded.map((item) => (
                <li class="flex gap-3 border-b border-border py-2.5 text-sm leading-6 text-subtle last:border-b-0">
                  <span class="font-bold text-danger" aria-hidden="true">×</span><span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </article>
  </div>
</section>
