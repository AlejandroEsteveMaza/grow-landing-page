---
import PricingCard from '../cards/PricingCard.astro';
import MaintenanceCard from '../cards/MaintenanceCard.astro';
import type { MaintenancePlan, PricingPlan, SectionCopy } from '../../types/content';

interface Props {
  plans: readonly PricingPlan[];
  maintenancePlans: readonly MaintenancePlan[];
  copy: SectionCopy;
}

const { plans, maintenancePlans, copy } = Astro.props;
---

<section class="border-b border-border bg-surface-strong" id="precios" aria-labelledby="pricing-title">
  <div class="mx-auto w-full max-w-site px-6 py-20 md:px-10 md:py-28 lg:px-16 lg:py-32">
    <p class="reveal flex items-center gap-3 text-[0.68rem] font-semibold uppercase tracking-[0.25em] text-primary">
      <span class="h-px w-6 bg-primary" aria-hidden="true"></span>{copy.eyebrow}
    </p>
    <h2 class="reveal mt-4 font-display text-[clamp(2.5rem,5vw,4.25rem)] font-black leading-[0.96] tracking-[-0.045em] text-foreground" id="pricing-title">
      {copy.title}<br /><span class="text-muted">{copy.mutedTitle}</span>
    </h2>
    <div class="mt-14 grid gap-6 md:mt-16 lg:grid-cols-2">
      {plans.map((plan) => <PricingCard plan={plan} />)}
    </div>

    {
      maintenancePlans.map((plan) => <MaintenanceCard plan={plan} />)
    }
  </div>
</section>
