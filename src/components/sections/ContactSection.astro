---
import WhatsAppButton from '../global/WhatsAppButton.astro';
import { deploymentEnvironment } from '../../lib/deployment';
interface Props {
  whatsappNumber: string | null;
  whatsappMessage: string;
  serviceOptions: readonly string[];
  description: string;
}

const { whatsappNumber, whatsappMessage, serviceOptions, description } = Astro.props;
const isLocal = import.meta.env.DEV && deploymentEnvironment === 'local';
---

<section id="contacto" aria-labelledby="contact-title">
  <div class="mx-auto grid w-full max-w-site gap-14 px-6 py-20 md:px-10 md:py-28 lg:grid-cols-2 lg:gap-20 lg:px-16 lg:py-32">
    <div>
      <p class="reveal flex items-center gap-3 text-[0.68rem] font-semibold uppercase tracking-[0.25em] text-primary">
        <span class="h-px w-6 bg-primary" aria-hidden="true"></span>Contacto
      </p>
      <h2 class="reveal mt-4 font-display text-[clamp(2.5rem,5vw,4.25rem)] font-black leading-[0.96] tracking-[-0.045em] text-foreground" id="contact-title">
        Hablemos de<br /><span class="text-muted">tu proyecto</span>
      </h2>
      <p class="reveal mt-7 max-w-xl text-base leading-7 text-muted">
        {description}
      </p>
      <div class="reveal mt-9">
        <WhatsAppButton number={whatsappNumber} message={whatsappMessage} />
      </div>
    </div>

    <form
      class="reveal grid gap-5"
      data-contact-form
      aria-busy="false"
      aria-describedby="form-notice"
      aria-disabled={!isLocal}
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="grid gap-2">
          <label class="text-xs font-semibold uppercase tracking-[0.12em] text-muted" for="name">Nombre</label>
          <input
            class="min-h-12 rounded-brand border border-border bg-surface px-4 py-3 text-sm text-foreground transition-colors placeholder:text-muted/70 hover:border-muted focus:border-primary"
            id="name"
            type="text"
            autocomplete="name"
            minlength="2"
            required
            disabled={!isLocal}
            placeholder="Tu nombre"
          />
        </div>
        <div class="grid gap-2">
          <label class="text-xs font-semibold uppercase tracking-[0.12em] text-muted" for="email">Email</label>
          <input
            class="min-h-12 rounded-brand border border-border bg-surface px-4 py-3 text-sm text-foreground transition-colors placeholder:text-muted/70 hover:border-muted focus:border-primary"
            id="email"
            type="email"
            autocomplete="email"
            required
            disabled={!isLocal}
            placeholder="tu@email.com"
          />
        </div>
      </div>

      <div class="grid gap-2">
        <label class="text-xs font-semibold uppercase tracking-[0.12em] text-muted" for="service">¿Qué necesitas?</label>
        <select
          class="min-h-12 rounded-brand border border-border bg-surface px-4 py-3 text-sm text-foreground transition-colors hover:border-muted focus:border-primary"
          id="service"
          required
          disabled={!isLocal}
        >
          <option value="" disabled selected>Selecciona un servicio</option>
          {serviceOptions.map((option) => <option value={option}>{option}</option>)}
        </select>
      </div>

      <div class="grid gap-2">
        <label class="text-xs font-semibold uppercase tracking-[0.12em] text-muted" for="message">Cuéntanos tu proyecto</label>
        <textarea
          class="min-h-32 resize-y rounded-brand border border-border bg-surface px-4 py-3 text-sm leading-6 text-foreground transition-colors placeholder:text-muted/70 hover:border-muted focus:border-primary"
          id="message"
          minlength="20"
          required
          disabled={!isLocal}
          placeholder="¿A qué te dedicas? ¿Qué quieres conseguir con tu web?"
        ></textarea>
      </div>

      <button
        class="min-h-12 rounded-brand bg-primary px-6 py-3 text-sm font-bold text-white transition-[background-color,transform] hover:-translate-y-0.5 hover:bg-primary-hover focus-visible:-translate-y-0.5 focus-visible:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:translate-y-0"
        type="submit"
        disabled={!isLocal}
        data-form-button
      >
        {isLocal ? 'Simular envío' : 'Envío no disponible'}
      </button>
      <p
        class="text-sm leading-6 text-muted"
        id="form-notice"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        tabindex="-1"
        data-form-notice
      >
        {isLocal
          ? 'Modo local: puedes simular el envío. No se enviará ni almacenará ningún dato.'
          : 'El envío no está habilitado en este entorno. No se enviará ni almacenará ningún dato.'}
      </p>
    </form>
  </div>
</section>

{
  isLocal && (
    <script is:inline>
      const form = document.querySelector('[data-contact-form]');
      const formButton = form?.querySelector('[data-form-button]');
      const formNotice = form?.querySelector('[data-form-notice]');
      let isSubmitting = false;

      if (form instanceof HTMLFormElement && formButton instanceof HTMLButtonElement && formNotice instanceof HTMLElement) {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          if (isSubmitting || !form.reportValidity()) return;

          isSubmitting = true;
          form.setAttribute('aria-busy', 'true');
          formButton.disabled = true;
          formButton.textContent = 'Simulando...';
          formNotice.textContent = 'Simulando el envío local...';

          window.setTimeout(() => {
            form.setAttribute('aria-busy', 'false');
            formButton.disabled = false;
            formButton.textContent = 'Simular envío';
            formNotice.textContent = 'Simulación completada. No se ha enviado ni almacenado ningún dato.';
            formNotice.focus();
            isSubmitting = false;
          }, 400);
        });
      }
    </script>
  )
}
