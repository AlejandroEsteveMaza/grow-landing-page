---
import { escapeHTML, toHTML } from '@portabletext/to-html';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedResources } from '../../lib/content';
import type { JsonLd, SeoMeta } from '../../types/content';

export async function getStaticPaths() {
  const resources = await getPublishedResources();
  return resources.map((resource) => ({ params: { slug: resource.slug }, props: { resource } }));
}

const { resource } = Astro.props;
const seo = { title: resource.seo.title, description: resource.seo.description, type: 'article', ...(resource.coverImageUrl ? { image: resource.coverImageUrl } : {}) } satisfies SeoMeta;
const articleSchema: JsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: resource.title,
  datePublished: resource.publishedAt,
  description: resource.excerpt,
};
const bodyHtml = toHTML(resource.body as Parameters<typeof toHTML>[0], {
  components: {
    types: {
      imageWithAlt: ({ value }) => {
        const url = value.asset?.url;
        const alt = value.alt?.trim();
        if (typeof url !== 'string' || !alt) return '';

        try {
          if (new URL(url).protocol !== 'https:') return '';
        } catch {
          return '';
        }

        return `<figure><img src="${escapeHTML(url)}" alt="${escapeHTML(alt)}" loading="lazy"></figure>`;
      },
    },
  },
});
---

<BaseLayout {...seo} schemas={[articleSchema]}>
  <article class="px-6 pb-20 pt-36 md:px-10 md:pb-28 md:pt-44 lg:px-16 lg:pb-32">
    <div class="mx-auto w-full max-w-3xl">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.25em] text-primary">{resource.category}</p>
      <h1 class="mt-4 font-display text-[clamp(2.5rem,5vw,4.25rem)] font-black leading-[0.96] tracking-[-0.045em] text-foreground">{resource.title}</h1>
      {resource.coverImageUrl && <img class="mt-10 aspect-[16/9] w-full rounded-card object-cover" src={resource.coverImageUrl} alt={resource.coverImageAlt ?? ''} loading="eager" />}
      <div class="portable-text mt-10 text-base leading-8 text-muted" set:html={bodyHtml} />
      {resource.action && <a class="mt-10 inline-flex min-h-12 items-center rounded-brand bg-primary px-7 py-3.5 text-sm font-bold text-white" href={resource.action.url}>{resource.action.label}</a>}
    </div>
  </article>
</BaseLayout>
