---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedResources } from '../../lib/content';
import type { SeoMeta } from '../../types/content';

const resources = await getPublishedResources();
const seo = {
  title: 'Recursos | GROW',
  description: 'Artículos y guías publicados por GROW.',
  noindex: resources.length === 0,
} satisfies SeoMeta;
---

<BaseLayout {...seo}>
  <section class="px-6 pb-20 pt-36 md:px-10 md:pb-28 md:pt-44 lg:px-16 lg:pb-32">
    <div class="mx-auto w-full max-w-site">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.25em] text-primary">Recursos</p>
      <h1 class="mt-4 font-display text-[clamp(2.5rem,5vw,4.25rem)] font-black leading-[0.96] tracking-[-0.045em] text-foreground">Artículos y guías</h1>
      {resources.length > 0 && <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {resources.map((resource) => <article class="rounded-card border border-border bg-surface p-7 sm:p-9">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">{resource.category}</p>
          <h2 class="mt-3 font-display text-2xl font-bold text-foreground"><a class="hover:text-primary focus-visible:text-primary" href={`/recursos/${resource.slug}`}>{resource.title}</a></h2>
          <p class="mt-4 text-sm leading-6 text-muted">{resource.excerpt}</p>
        </article>)}
      </div>}
    </div>
  </section>
</BaseLayout>
